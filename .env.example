# TeleHealth Server Configuration
PORT=3000
NODE_ENV=development

# Telegram Bot Integration
# Biarkan kosong jika ingin menggunakan built-in Web Chat Simulator
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_POLLING=true

# Database Configuration (PostgreSQL / SQLite fallback)
# Jika DATABASE_URL diisi, sistem akan otomatis menggunakan PostgreSQL
# Contoh: postgres://postgres:password@localhost:5432/telehealth_db
DATABASE_URL=

# Admin Credentials
ADMIN_SECRET_KEY=telehealth-secret-key-2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# n8n Automation Webhook URL (Opsional)
# n8n webhook untuk forward event dari chatbot atau dokter
N8N_MAIN_WEBHOOK_URL=http://localhost:5678/webhook/telehealth-chat
N8N_DOCTOR_WEBHOOK_URL=http://localhost:5678/webhook/telehealth-doctor-answer
